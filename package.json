{
  "name": "tekk2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "harness": "tsx scripts/harness.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-course.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/ws-transport": "^0.18.4",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  }
}
