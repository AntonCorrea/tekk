# ------------------------------------------------------------------
# Monad testnet on-chain match record (Stage 1).
# Copy this file to `.env`, fill it in, and NEVER commit the real `.env`.
# Loaded by server/matchRecord.ts via Node's built-in `process.loadEnvFile`,
# so there is no dotenv dependency.
#
# Leave MATCH_RECORD_ENABLED unset (or leave any value below empty) to keep
# the hook an inert no-op -- local dev, the harness and smoke never touch
# the chain.
# ------------------------------------------------------------------
MATCH_RECORD_ENABLED=1
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MATCH_SIGNER_KEY=
# Filled in after `npm run deploy:testnet` inside tekk2/contracts.
MATCH_RECORD_ADDRESS=

# ------------------------------------------------------------------
# Lobby leaderboard (Stage 2).
# The client's only reader of the chain: an Envio HyperIndex indexer turns the
# MatchRecord events into GraphQL (see tekk2/indexer/). Set the deployed
# endpoint to light up the lobby's "records" panel. Leave it empty and the
# panel simply says nothing is indexed yet -- the game is unaffected.
#
# VITE_* is build-time and public: it is compiled into the client bundle, so
# only ever put a public URL here.
# ------------------------------------------------------------------
VITE_LEADERBOARD_URL=

# ------------------------------------------------------------------
# Privy identity + wallet-signed match records (Stage 3).
#
# Racer identities, and the wallets the on-chain records credit. A racer signs
# one statement at join (`src/shared/identity.ts`); the server recovers the
# address from that signature and writes it to MatchRecord, so the leaderboard
# stops being all zeros.
#
# Everything here is optional, and half-configuration counts as none:
#
#   - PRIVY_APP_ID + PRIVY_APP_SECRET  -> joins must also carry a valid Privy
#     access token. The SECRET is server-only: never a VITE_* variable, never
#     in a build, never in git. Missing either one leaves the check off and
#     every racer is a guest.
#   - VITE_PRIVY_APP_ID + VITE_PRIVY_CLIENT_ID -> the client shows the real
#     login card. Both are public by design (they ship in the bundle). With
#     them unset the client keeps the off-chain placeholder card and never
#     downloads the Privy SDK.
#
# With none of it set, the game behaves exactly as it did before: a placeholder
# login, no wallet, and every match recorded against the zero address.
#
# Also allow the dev origin in the Privy dashboard: http://localhost:5173 for
# the embedded wallet's secure-context iframe, and
# http://localhost:5173/login-callback as an allowed OAuth redirect URI (that is
# where Google sends the browser back; the client finishes the login there).
# Without the second one the Google row starts a flow that cannot return.
# ------------------------------------------------------------------
PRIVY_APP_ID=
PRIVY_APP_SECRET=
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=