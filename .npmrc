# Privy's browser SDK (@privy-io/js-sdk-core) declares an *optional* peer on
# `permissionless`, which in turn demands `ox@^0.8.0`. That cannot coexist with
# the `ox` that viem ships (0.14.x), and npm still tries to install optional
# peers -- so a plain `npm install` dies with ERESOLVE on a package this project
# never imports.
#
# `legacy-peer-deps` stops npm from auto-installing peers. It is safe here
# because every peer this project actually needs is declared as a direct
# dependency -- notably `express`, a peer of @colyseus/ws-transport, which would
# otherwise be dropped from the tree. Keeping the lockfile installable by a plain
# `npm ci` is the whole point, so do not remove this without re-testing both
# `npm install` and the harness suite.
legacy-peer-deps=true
