# Monad testnet (chain 10143). Copy this file to `.env` and fill it in.
# Never commit the real `.env`.

# Public QuickNode RPC works fine; any testnet RPC is OK.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Hex private key (0x...) of a funded testnet wallet. This is the deployer for
# Stage 1 -- the same key the game server uses to write match records.
MATCH_SIGNER_KEY=